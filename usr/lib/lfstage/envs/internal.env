# envs/internal.env
# Internal environment setup for LFStage

# Debugging
# set -x
# trap 'echo "ERROR: $BASH_SOURCE:$LINENO: $BASH_COMMAND" >&2' ERR

# Environment variables
export TZ=UTC
export LFS=/var/lib/lfstage/mount
export TERM=xterm-256color
export LC_ALL=POSIX

# Settings
umask 022
set -euo pipefail

# Functions
die() { echo "@log@err$1" >&2; return "${2:-1}"; }
log_error() { echo "@log@err$1" >&2; }
log_warn () { echo "@log@wrn$1" >&2; }
log_info () { echo "@log@inf$1" >&2; }
log_debug() { echo "@log@dbg$1" >&2; }
log_trace() { echo "@log@trc$1" >&2; }

export -f log_error log_warn log_info log_debug log_trace die

# Internally handled due to profile references:
# * `export ENVS=${envs_dir}`
# * `source ${base_env}`
#
# These are appended below at runtime
